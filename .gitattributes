# 统一换行符：仓库内一律 LF，避免 Windows 下 CRLF 造成的假 diff
* text=auto eol=lf

# 明确指定文本类型
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.svg    text eol=lf

# 二进制文件不做换行转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
